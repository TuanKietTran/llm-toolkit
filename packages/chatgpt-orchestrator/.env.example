# Copy to .env and fill in. NEVER commit the real .env.
#
# Env vars are prefixed ORCH_ and override config/config.toml. Nested settings use a double
# underscore, e.g. ORCH_BROWSER__DRIVER maps to [browser].driver. List/JSON settings
# (accounts, inward MCP servers) are supplied as JSON strings.

# --- Runtime ---
ORCH_LOG_LEVEL=INFO
ORCH_LOG_JSON=false
# Optional: point at a specific config.toml (otherwise auto-discovered from cwd).
# ORCH_CONFIG_FILE=/absolute/path/to/config/config.toml

# --- Browser (override [browser] in config.toml) ---
# driver: "patchright" (recommended) or "playwright"
ORCH_BROWSER__DRIVER=patchright
ORCH_BROWSER__CHANNEL=chrome
ORCH_BROWSER__HEADLESS=false

# --- Scaling (override [scaling]) — examples ---
# ORCH_SCALING__MAX_CONTEXTS=8
# ORCH_SCALING__MIN_WARM=1

# --- Accounts (JSON array; one entry per identity) ---
# mode: "anonymous" | "credentialed"
# proxy: full proxy URL incl. creds, e.g. http://user:pass@host:port  (residential recommended)
# storage_state: path to a captured storage_state.json (required for credentialed)
ORCH_ACCOUNTS='[
  {"id": "anon-1", "mode": "anonymous", "proxy": "", "budget_messages": 8, "budget_window_seconds": 18000},
  {"id": "anon-2", "mode": "anonymous", "proxy": "", "budget_messages": 8, "budget_window_seconds": 18000}
]'

# Optional host-VPN guard. The orchestrator never changes routes or starts/stops the VPN.
# ORCH_NETWORK__VPN_REQUIRED=true
# ORCH_NETWORK__VPN_INTERFACE=wg0

# Optional bounded coding/browser tools for the three demo platforms. Workers can only read/write
# /home/kyle/demo-plan and run allowlisted, headless Playwright projects or data validation.
# ORCH_INWARD_MCP_SERVERS='[{"name":"demo-workspace","transport":"stdio","command":"/home/kyle/chatgpt-orchestrator/.venv/bin/python","args":["/home/kyle/chatgpt-orchestrator/examples/demo_workspace_mcp.py"],"env":{"DEMO_WORKSPACE_ROOT":"/home/kyle/demo-plan"}}]'

# --- Email aliasing / masking + OTP reading (multi-account management) ---
# provider: "none" | "duckduckgo"
ORCH_EMAIL__PROVIDER=none
# DuckDuckGo Email Protection (unlimited random@duck.com aliases via the quack API).
# Token comes from the DDG extension/dashboard, or `orchestrator accounts ddg-login`.
# ORCH_EMAIL__DDG_ACCESS_TOKEN=
# ORCH_EMAIL__DDG_USERNAME=
# Destination inbox that aliases forward to, for auto-reading ChatGPT login codes (IMAP).
# Gmail: use an App Password, not your account password.
# ORCH_EMAIL__IMAP_HOST=imap.gmail.com
# ORCH_EMAIL__IMAP_USERNAME=you@gmail.com
# ORCH_EMAIL__IMAP_PASSWORD=your-app-password
# ORCH_EMAIL__IMAP_MAILBOX=INBOX

# --- Job-site accounts (JSON array; ITviec/LinkedIn search+apply, see src/orchestrator/jobsite/) ---
# Real credentialed identities only -- there is no "anonymous" mode here. storage_state must point
# at a session captured by a HUMAN logging in by hand (never scripted -- MFA/CAPTCHA-safe by
# design):
#   uv run python -m orchestrator.jobsite.capture_session --site itviec --out storage_state/itviec.storage_state.json
#   uv run python -m orchestrator.jobsite.capture_session --site linkedin --out storage_state/linkedin.storage_state.json
# Until both files exist, jobsite_search/jobsite_apply raise LoginRequired for that site.
# ORCH_JOBSITE_ACCOUNTS='[
#   {"id": "itviec", "site": "itviec", "storage_state": "storage_state/itviec.storage_state.json", "proxy": ""},
#   {"id": "linkedin", "site": "linkedin", "storage_state": "storage_state/linkedin.storage_state.json", "proxy": ""}
# ]'

# --- Inward MCP servers to (optionally) equip workers with ---
# JSON array of {name, transport: "stdio"|"http", command|url, args, env}
ORCH_INWARD_MCP_SERVERS='[]'
